{
  "openapi": "3.1.0",
  "info": {
    "title": "API Ticket",
    "description": "API for generating random ticket IDs",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1"
    }
  ],
  "paths": {
    "/ticket": {
      "get": {
        "summary": "Generate a random ticket ID",
        "description": "Returns a random ticket ID with 16 characters in xxxPKYYMMDDttttt format",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticketId": {
                      "type": "string",
                      "example": "SJK4D8F0L9N2M1P7"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  }
}